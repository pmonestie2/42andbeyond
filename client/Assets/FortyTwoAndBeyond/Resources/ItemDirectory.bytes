rice":618,"stack":60,"description":"Hive Core from a Mazzaroth Shear.","manufacturer":"","stats":"","effects":""},{"id":6055,"name":"Holographic Emitter","type":13,"icon":996,"level":9,"price":2827,"stack":60,"description":"These emitters are used both inside ships for display purposes, and outside ships for camouflage.","manufacturer":"","stats":"","effects":""},{"id":5246,"name":"Holomagazines","type":13,"icon":1280,"level":2,"price":110,"stack":1,"description":"Take luxury to a whole new height with holomagazines! Turn the pages and watch the pictures pop out right at you. The pictures can change or move while you are looking at them.\n\nThis luxury is in demand at Orsini Mining Platform (Carpenter, Beta Hydri).","manufacturer":"","stats":"","effects":""},{"id":5247,"name":"Holomusic","type":13,"icon":1381,"level":2,"price":89,"stack":1,"description":"Load holomusic into your Tri-D Projector and watch your favorite bands come alive. The bands will appear to be right in front of you as if you were at a live concert.\n\nHolomusic is in demand at Orsini Mining Platform (Carpenter, Beta Hydri System).","manufacturer":"","stats":"","effects":""},{"id":3932,"name":"Homemade Fishing Line","type":13,"icon":2082,"level":4,"price":5812,"stack":1,"description":"Refined from: Diamond Filament.\nBraided diamond filament is known for its incredible tensile strength.","manufacturer":"","stats":"","effects":""},{"id":2954,"name":"Homerite","type":13,"icon":1483,"level":6,"price":358,"stack":300,"description":"Refines to: Homerium","manufacturer":"","stats":"","effects":""},{"id":3520,"name":"Homerium","type":13,"icon":1486,"level":6,"price":14333,"stack":60,"description":"Refined from: Homerite","manufacturer":"","stats":"","effects":""},{"id":3208,"name":"Honor","type":7,"icon":867,"level":3,"price":12559,"stack":1,"description":"BlackSun Honor Reactors.","manufacturer":"Blacksun","stats":"Skill required: Reactor Tech\nRequirement: Level 3 Reactor Tech\nReactor capacity: 506\nR