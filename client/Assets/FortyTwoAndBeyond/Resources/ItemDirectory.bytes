":4,"price":39019,"stack":1,"description":"BlackSun Dragonflight Engine gives an increase shield recharge rate.","manufacturer":"Blacksun","stats":"Skill required: Engine Tech\nRequirement: Level 4 Engine Tech\nEngine signature: 3900\nImpulse speed: 110\nWarp speed: 3000\nFree-warp energy / sec: 12.8","effects":"Recharge Shields (Equip)\n+26.0% Shield Recharge when equipped."},{"id":2593,"name":"Dragonflight Gold","type":6,"icon":967,"level":6,"price":192782,"stack":1,"description":"BlackSun Dragonflight Engine gives an increased shield recharge rate.","manufacturer":"Blacksun","stats":"Skill required: Engine Tech\nRequirement: Level 6 Engine Tech\nEngine signature: 4000\nImpulse speed: 140\nWarp speed: 3500\nFree-warp energy / sec: 21.5","effects":"Recharge Shields (Equip)\n+34.0% Shield Recharge when equipped."},{"id":2577,"name":"Dragonflight Silver","type":6,"icon":967,"level":5,"price":88142,"stack":1,"description":"BlackSun Dragonflight Engine gives an increased shield recharge rate.","manufacturer":"Blacksun","stats":"Skill required: Engine Tech\nRequirement: Level 5 Engine Tech\nEngine signature: 4400\nImpulse speed: 125\nWarp speed: 3250\nFree-warp energy / sec: 17","effects":"Recharge Shields (Equip)\n+30.0% Shield Recharge when equipped."},{"id":3791,"name":"Dragons Dread Mail Elite Mk IX","type":2,"icon":2181,"level":9,"price":2986315,"stack":1,"description":"Blacksun Shield\nExperimental System. Use at own risk.\nOffered with great appreciation to the destroyers of the dreaded Controller.","manufacturer":"Blacksun","stats":"Skill required: Shield Tech\nRequirement: Level 9 Shield Tech\nShield capacity: 114411\nShield recharge / sec: 738.3","effects":"Turbo Weapons (Activated)\nReduces Weapons Delay by 15% for 2520 seconds when activated.\n\nIncrease Shield Capacity (Equip)\n+10280 Shield Capacity when equipped.\n\nIncrease Skill Success (Equip)\nIncreases the damage required to interrupt your skill use by 10% when equipped."},{"id":553,"name":"DragonSpike Projectile","type":10,"icon":717,"level":3,"price":12,"stack":400,"description":"BlackSun Dragonspike Projectiles.","manufacturer":"Blacksun","stats":"Ammunition: Dragon Spike\nWeapon damage: 9\nDamage type: Impact\nSkill required: Projectile Weapon\nRequirement: Level 3 Projectile Weapon","effects":""},{"id":584,"name":"DragonSpit Missile","type":10,"icon":653,"level":4,"price":15,"stack":130,"description":"BlackSun Dragonspit missiles are modified Dragonfire missiles containing a highly corrosive chemical warhead.","manufacturer":"Blacksun","stats":"Ammunition: Dragonspit\nWeapon damage: 85\nDamage type: Explosive\nSkill required: Missile Weapon\nRequirement: Level 4 Missile Weapon\nMissile maneuverability: 187\nWeapon range (m): 5200","effects":""},{"id":530,"name":"Dragontooth Projectile","type":10,"icon":663,"level":2,"price":8,"stack":300,"description":"BlackSun Dragontooth projectiles are typical ordinance for Red Dragon Tong members. They are high mass impact projectiles created from depleted uranium composite, and are fired from Dragontooth-series projectile weapons.","manufacturer":"Blacksun","stats":"Ammunition: Dragontooth\nWeapon damage: 6\nDamage type: Impact\nSkill required: Projectile Weapon\nRequirement: Level 2 Projectile Weapon","effects":""},{"id":5235,"name":"Drive Waste","type":13,"icon":145,"level":1,"price":51,"stack":1,"description":"A by-product of nuclear reactors used to power stations in desolate areas.\n\nThis particular item is shipped out from Tokai Saikutsu and Inverness Downs.","manufacturer":"","stats":"","effects":""},{"id":5466,"name":"Drone Actuator","type":13,"icon":736,"level":1,"price":1864,"stack":100,"description":"A drone actuator.","manufacturer":"","stats":"","effects":""},{"id":3960,"name":"Drone Battery","type":13,"icon":1497,"level":4,"price":4331,"stack":1,"description":"A battery recovered from a destroyed drone. Nothing able to be used but could easily be sold for scrap.","manufacturer":"","stats":"","effects":""},{"id":5777,"name":"Drone Circuits","type":13,"icon":739,"level":5,"price":5423,"stack":100,"description":"Circuits boards from a wayward drone.","manufacturer":"","stats":"","effects":""},{"id":2321,"name":"Drone Controller Shield PROM","type":11,"icon":2175,"level":8,"price":989540,"stack":1,"description":"A pre-programed module that enables a cybernetic being to build shields of all kinds. Used by a non-cybernetic entity, it will aid in the building of known shield devices.","manufacturer":"","stats":"Skill required: Device Tech\nRequirement: Level 8 Device Tech","effects":"Improved Build Shields (Equip)\nIncreases Build Shields Skill by 0.49 levels when equipped."},{"id":789,"name":"Drone Defense Laser","type":14,"icon":670,"level":2,"price":4539,"stack":1,"description":"A beam weapon salvaged from a destroyed drone. ","manufacturer":"","stats":"Weapon damage: 5\nDamage type: Energy\nEnergy use: 14\nSkill required: Beam Weapon\nRequirement: Level 2 Beam Weapon\nWeapon range (m): 1000\nReload (sec): 2","effects":""},{"id":1840,"name":"Drone Detector Array","type":11,"icon":650,"level":2,"price":5895,"stack":1,"description":"A system scavenged from a drone that can be equipped in a device slot to help boost a ship's scan range.","manufacturer":"","stats":"Skill required: Device Tech\nRequirement: Level 2 Device Tech","effects":"Scan Boost (Equip)\nAllows ship scanners to see 1050 units farther when equipped."},{"id":2421,"name":"Drone Energy Amplifier","type":11,"icon":2176,"level":9,"price":2683676,"stack":1,"description":"This device increases energy storage efficiency and defensive capabilitiy in the worker drrones that operatate under The Controller.","manufacturer":"","stats":"Skill required: Device Tech\nRequirement: Level 9 Device Tech","effects":"Reactor Boost (Activated)\nIncreases Reactor capacity by 23%  for 2300 seconds when activated.\n\nTurbo Weapons (Activated)\nReduces Weapons Delay by 10% for 1760 seconds when activated."},{"id":921,"name":"Drone Plasma Laser","type":14,"icon":670,"level":4,"price":23444,"stack":1,"description":"Plasma beam weapon taken from a destroyed drone.","manufacturer":"","stats":"Weapon damage: 40\nDamage type: Plasma\nEnergy use: 54\nSkill required: Beam Weapon\nRequirement: Level 4 Beam Weapon\nWeapon range (m): 1200\nReload (sec): 6","effects":""},{"id":5477,"name":"Drone Scrap","type":13,"icon":1480,"level":1,"price":480,"stack":100,"description":"Scrap from a destroyed drone. ","manufacturer":"","stats":"","effects":""},{"id":2423,"name":"Drone Shield Amplifier","type":11,"icon":2176,"level":9,"price":2683676,"stack":1,"description":"This device increases shield capacity levels in the worker drones that operate under The Controller.","manufacturer":"","stats":"Skill required: Device Tech\nRequirement: Level 9 Device Tech","effects":"Maximize Shields (Activated)\nIncreases shield capacity by 8% for 2420.0 seconds when activated.\n\nEquipment Damage Control - Shields (Equip)\nIncreases your shield's effectiveness at sustaining damage by 75% when equipped.\n\nEquipment Damage Control - Reactor (Equip)\nIncreases your reactor's effectiveness at sustaining damage by 75% when equipped."},{"id":2262,"name":"Drone Siphon","type":11,"icon":743,"level":7,"price":345011,"stack":1,"description":"A fragment of advanced cybernetic technology.","manufacturer":"","stats":"Skill required: Device Tech\nRequirement: Level 7 Device Tech","effects":"Weapon Energy Drain (Activated)\nIncrease Weapon Energy Cost by 19.90% for 95 seconds on enemy when activated."},{"id":5699,"name":"Drone System","type":13,"icon":728,"level":3,"price":3891,"stack":100,"description":"The control system of a Drone.","manufacturer":"","stats":"","effects":""},{"id":3408,"name":"Dry Ice","type":13,"icon":189,"level":2,"price":23,"stack":60,"description":"Refined From: Carbone Dioxide Gas\nSuper cooled Carbone Dioxide used in various applications.","manufacturer":"","stats":"","effects":""},{"id":3845,"name":"Duct Tape","t