<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>9</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="PeerChecks.cs" />
    <None Include="Fixtures/*.hex" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../Assets/FortyTwoAndBeyond/Client/FlightThrottle.cs" Link="FlightThrottle.cs" />
    <Compile Include="../Assets/FortyTwoAndBeyond/Client/StationWalkState.cs" Link="StationWalkState.cs" />
    <ProjectReference Include="FortyTwoAndBeyond.Protocol.csproj" />
  </ItemGroup>
</Project>
